# Cam Vadisi - ornek ortam dosyasi. Kopyalayip `.env` olarak kaydedin.
# Gercek .env ASLA depoya girmez (.gitignore).

PORT=3001

# Yonetim panelinin tek sifresi.
ADMIN_PASSWORD=degistir-beni

# JWT imza anahtari. Uretimde ZORUNLU; su komutla uretin:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Veritabani dosyasi. Bos birakilirsa <proje>/CamVadisiDatabase/data.db kullanilir.
DB_PATH=

# Yuklenen gorsellerin klasoru. Bos birakilirsa server/uploads kullanilir.
UPLOAD_DIR=

# Derlenmis yonetim panelinin klasoru (ayni origin'den /panel altinda sunulur).
# Ornek: /var/www/cam-vadisi/panel
PANEL_DIR=
