[Unit]
Description=Cam Vadisi Restorant menu API
After=network.target

[Service]
Type=simple
User=camvadisi
WorkingDirectory=/var/www/cam-vadisi/app
ExecStart=/usr/bin/node server/index.js
Restart=on-failure
RestartSec=3
Environment=NODE_ENV=production
# Sirlar ve yollar EnvironmentFile'dan gelir (asagidaki .env.production).
EnvironmentFile=/var/www/cam-vadisi/app/.env.production

[Install]
WantedBy=multi-user.target
